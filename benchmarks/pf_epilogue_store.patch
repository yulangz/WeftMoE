diff --git a/src/cuda/weftmoe_pf/epilogue_ablation.cuh b/src/cuda/weftmoe_pf/epilogue_ablation.cuh
new file mode 100644
--- /dev/null
+++ b/src/cuda/weftmoe_pf/epilogue_ablation.cuh
@@ -0,0 +1,60 @@
+#pragma once
+
+// Temporary experiment, exported as a patch rather than a production option.
+// 0: production; 1: FC1 vector; 2: FC2 linear/vector; 3: FC2 linear/bulk TMA.
+#ifndef WEFTMOE_PF_EPILOGUE_ABLATION
+#define WEFTMOE_PF_EPILOGUE_ABLATION 0
+#endif
+
+#if WEFTMOE_PF_EPILOGUE_ABLATION >= 2
+namespace weftmoe_pf::local {
+#if defined(CUTE_ARCH_MMA_SM90A_ENABLED) && __has_include(<nccl_device.h>)
+template <bool Tma>
+__device__ __forceinline__ void ablate_fc2_store(
+    const ForwardKernelArgs &a, Shared &s, const float *accum, const Task &t) {
+  const auto lane = threadIdx.x & 31U;
+  const auto warp = threadIdx.x / 32U;
+  const auto row0 = warp * 16U + lane / 4U;
+#pragma unroll
+  for (unsigned index = 0; index < Mma::kNumAccum / 4U; ++index) {
+    const auto column = index * 8U + (lane % 4U) * 2U;
+    *reinterpret_cast<__nv_bfloat162 *>(s.output + row0 * kN + column) =
+        __float22bfloat162_rn(make_float2(accum[index * 4U], accum[index * 4U + 1U]));
+    *reinterpret_cast<__nv_bfloat162 *>(s.output + (row0 + 8U) * kN + column) =
+        __float22bfloat162_rn(make_float2(accum[index * 4U + 2U], accum[index * 4U + 3U]));
+  }
+  if constexpr (Tma)
+    cute::tma_store_fence();
+  collective_scope_sync<kMathThreads, 7U>();
+  if constexpr (Tma) {
+    if (lane == 0U) {
+#pragma unroll
+      for (unsigned row = warp; row < kM; row += kMathThreads / 32U) {
+        if (row < t.rows) {
+          auto *destination = static_cast<transport::BFloat16 *>(
+              a.ring.rows[t.block * kM + row].output) + t.column * kN;
+          cute::SM90_BULK_COPY_S2G::copy(s.output + row * kN, destination, kN * 2U);
+        }
+      }
+      cute::tma_store_arrive();
+      asm volatile("cp.async.bulk.wait_group.read 0;" ::: "memory");
+    }
+  } else {
+    constexpr auto row_lanes = kN / 8U;
+#pragma unroll
+    for (unsigned row = threadIdx.x / row_lanes; row < kM;
+         row += kMathThreads / row_lanes) {
+      if (row < t.rows) {
+        const auto column = (threadIdx.x % row_lanes) * 8U;
+        auto *destination = static_cast<transport::BFloat16 *>(
+            a.ring.rows[t.block * kM + row].output) + t.column * kN;
+        *reinterpret_cast<uint4 *>(destination + column) =
+            *reinterpret_cast<const uint4 *>(s.output + row * kN + column);
+      }
+    }
+  }
+  collective_scope_sync<kMathThreads, 7U>();
+}
+#endif
+} // namespace weftmoe_pf::local
+#endif
