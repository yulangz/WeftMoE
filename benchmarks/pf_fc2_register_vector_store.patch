diff --git a/src/cuda/weftmoe_pf/fc2_epilogue.cuh b/src/cuda/weftmoe_pf/fc2_epilogue.cuh
index 95f85eb..4f55540 100644
--- a/src/cuda/weftmoe_pf/fc2_epilogue.cuh
+++ b/src/cuda/weftmoe_pf/fc2_epilogue.cuh
@@ -3,6 +3,40 @@
 // Included inside forward_compute_detail after the fragment-layout and named
 // barrier helpers.  Keeping this specialization out of the generic epilogue
 // avoids carrying static peer addressing through the dynamic V3 epilogue.
+template <unsigned TileN, unsigned MathThreads = kMathThreads>
+__device__ __forceinline__ void static_v4_push_fc2_register_vector_tile(
+    const ForwardKernelArgs &a, const float *accum, std::uint32_t valid_rows,
+    std::uint32_t column_base, std::uint64_t mblock) {
+  static_assert(TileN % 32U == 0U);
+  const auto lane = threadIdx.x % 32U;
+  const auto row0 = (threadIdx.x / 32U) * 16U + lane / 4U;
+#pragma unroll
+  for (unsigned item = 0; item < 2U; ++item) {
+    const auto row = row0 + item * 8U;
+    if (row >= valid_rows)
+      continue;
+    auto *destination = static_cast<transport::BFloat16 *>(
+        a.ring.rows[mblock * forward_tuning::kTileM + row].output);
+#pragma unroll
+    for (unsigned index = 0; index < TileN / 8U; index += 4U) {
+      std::uint32_t words[4];
+#pragma unroll
+      for (unsigned j = 0; j < 4U; ++j) {
+        const auto *value = accum + (index + j) * 4U + item * 2U;
+        words[j] = float2_to_bf16x2_bits(value[0], value[1]);
+      }
+      const auto vector = static_v4_transpose_register_vector(
+          make_uint4(words[0], words[1], words[2], words[3]));
+      const auto column = column_base + index * 8U + (lane % 4U) * 8U;
+      *reinterpret_cast<uint4 *>(destination + column) = vector;
+    }
+  }
+  // Join both math warpgroups before recycling S. As in the staged path,
+  // contribution publication is deferred to the terminal rank barrier.
+  cutlass::arch::NamedBarrier::sync(MathThreads,
+                                    physical_barrier<true>(kMathDoneBarrier));
+}
+
