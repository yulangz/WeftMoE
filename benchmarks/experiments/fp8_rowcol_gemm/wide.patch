+// Convert a row-scaled operand directly into the next WGMMA shared stage.
+// Each warp owns eight channels, using eight lanes per channel pair.
+// Sixteen packed BF16 values balance instruction count and register pressure.
+__device__ __forceinline__ void row_to_column_shared(
+    const std::uint8_t *tile, const float *row_scales, unsigned rows,
+    std::uint8_t *output, float *scales, unsigned begin, unsigned columns) {
+  const unsigned lane = threadIdx.x % 32U;
+  const unsigned warp = threadIdx.x / 32U;
+#pragma unroll 1
+  for (unsigned stripe = 0U; stripe < columns; stripe += 64U) {
+    const unsigned column = begin + stripe + warp * 8U + lane % 4U * 2U;
+    unsigned values[16], maximum = 0U;
+#pragma unroll
+    for (unsigned i = 0U; i < 16U; ++i) {
+      const unsigned row = lane / 4U + i * 8U;
+      unsigned bits = 0U;
+      if (row < rows) {
+        __nv_fp8x2_e4m3 q;
+        q.__x = *reinterpret_cast<const unsigned short *>(tile + tile_offset(row, column));
+        const auto decoded = static_cast<float2>(q);
+        const float scale = row_scales[row];
+        const auto pair = __float22bfloat162_rn(make_float2(decoded.x * scale, decoded.y * scale));
+        bits = reinterpret_cast<const unsigned &>(pair);
+      }
+      values[i] = bits;
+      maximum = __vmaxu2(maximum, bits & 0x7fff7fffU);
+    }
+#pragma unroll
+    for (unsigned delta = 4U; delta <= 16U; delta *= 2U)
+      maximum = __vmaxu2(maximum, __shfl_xor_sync(0xffffffffU, maximum, delta));
+    const unsigned am = maximum & 0xffffU;
+    const unsigned bm = maximum >> 16U;
+    const float sa = am >= 0x7f80U ? nanf("") : block_scale(__uint_as_float(am << 16U));
+    const float sb = bm >= 0x7f80U ? nanf("") : block_scale(__uint_as_float(bm << 16U));
+    const float ia = am >= 0x7f80U ? sa : __uint_as_float(0x7f000000U - __float_as_uint(sa));
+    const float ib = bm >= 0x7f80U ? sb : __uint_as_float(0x7f000000U - __float_as_uint(sb));
+    if (lane < 4U) {
+      scales[column] = sa;
+      scales[column + 1U] = sb;
+    }
+#pragma unroll
+    for (unsigned i = 0U; i < 16U; ++i) {
+      const auto bits = values[i];
+      const unsigned q = __nv_fp8x2_e4m3(make_float2(
+          __uint_as_float(bits << 16U) * ia,
+          __uint_as_float(bits & 0xffff0000U) * ib)).__x;
+      const auto next = __shfl_xor_sync(0xffffffffU, q, 4U);
+      const unsigned lo = q | (next << 16U);
+      const auto hi = __shfl_xor_sync(0xffffffffU, lo, 8U);
+      if (!(lane / 4U % 4U)) {
+        *reinterpret_cast<unsigned *>(output + tile_offset(column, lane / 4U + i * 8U)) =
+            __byte_perm(lo, hi, 0x6420U);
+        *reinterpret_cast<unsigned *>(output + tile_offset(column + 1U, lane / 4U + i * 8U)) =
+            __byte_perm(lo, hi, 0x7531U);
+      }
+    }
+  }
+}
 
