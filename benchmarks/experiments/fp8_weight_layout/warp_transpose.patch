+// Each warp owns a pair of 16x16 tiles; only one 4x4 byte fragment/thread
+// stays live. Off-diagonal partners are both read before either is overwritten.
+template <unsigned N>
+__device__ __forceinline__ void transpose_weight_tile(std::uint8_t *data) {
+  const unsigned warp = threadIdx.x / 32U, lane = threadIdx.x % 32U;
+  for (unsigned task = warp; task < (N / 128U) * 36U; task += 8U) {
+    unsigned pair = task % 36U, br = 0U;
+    while (pair >= 8U - br) { pair -= 8U - br; ++br; }
+    unsigned bc = br + pair;
+    if (lane >= 16U) { unsigned v = br; br = bc; bc = v; }
+    auto *base = data + (task / 36U) * 16384U;
+    const unsigned row = br * 16U + (lane % 16U) / 4U * 4U;
+    const unsigned col = bc * 16U + (lane % 4U) * 4U;
+    const auto a = *reinterpret_cast<const unsigned *>(base + fp8::tile_offset(row, col));
+    const auto b = *reinterpret_cast<const unsigned *>(base + fp8::tile_offset(row + 1U, col));
+    const auto c = *reinterpret_cast<const unsigned *>(base + fp8::tile_offset(row + 2U, col));
+    const auto d = *reinterpret_cast<const unsigned *>(base + fp8::tile_offset(row + 3U, col));
+    const auto lo0 = __byte_perm(a,b,0x5140), lo1 = __byte_perm(c,d,0x5140);
+    const auto hi0 = __byte_perm(a,b,0x7362), hi1 = __byte_perm(c,d,0x7362);
+    const auto v = make_uint4(__byte_perm(lo0,lo1,0x5410), __byte_perm(lo0,lo1,0x7632),
+                              __byte_perm(hi0,hi1,0x5410), __byte_perm(hi0,hi1,0x7632));
+    __syncwarp();
+    if (br != bc || lane < 16U) {
+      *reinterpret_cast<unsigned *>(base + fp8::tile_offset(col, row)) = v.x;
+      *reinterpret_cast<unsigned *>(base + fp8::tile_offset(col + 1U, row)) = v.y;
+      *reinterpret_cast<unsigned *>(base + fp8::tile_offset(col + 2U, row)) = v.z;
+      *reinterpret_cast<unsigned *>(base + fp8::tile_offset(col + 3U, row)) = v.w;
+    }
+  }
+  asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+  fp8::MathSync::sync();
+}
