+// E4M3 finite values are normal in FP16 and have only three mantissa bits.
+// For normal-range pow2 scales, change the packed exponent directly rather
+// than converting through FP32. Exceptional ranges retain the original path.
+__device__ __forceinline__ unsigned decode_scaled_e4m3_pair(unsigned q, float scale) {
+  const unsigned sb = __float_as_uint(scale), exponent = sb >> 23U;
+  if ((sb & 0x807fffffU) == 0U && exponent >= 10U && exponent <= 245U &&
+      (q & 0x7fU) != 0x7fU && ((q >> 8U) & 0x7fU) != 0x7fU) {
+    const auto h = __nv_cvt_fp8x2_to_halfraw2(static_cast<__nv_fp8x2_storage_t>(q), __NV_E4M3);
+    const unsigned bits = unsigned(h.x) | (unsigned(h.y) << 16U);
+    const unsigned magnitude = bits & 0x7fff7fffU;
+    const unsigned offset = unsigned(int(exponent) - 15) * 128U & 0xffffU;
+    const unsigned result = __vadd2((magnitude >> 3U) & 0x0fff0fffU,
+                                    offset | (offset << 16U));
+    return (result & ~__vcmpeq2(magnitude, 0U)) | (bits & 0x80008000U);
+  }
+  __nv_fp8x2_e4m3 v; v.__x = q;
+  const auto decoded = static_cast<float2>(v);
+  const auto result = __float22bfloat162_rn(make_float2(decoded.x * scale, decoded.y * scale));
+  return reinterpret_cast<const unsigned &>(result);
+}
 
