+template <typename State>
+__device__ static __forceinline__ nvshmemi_ibgda_device_qp_t* ibgda_get_rc_impl(State* state, int pe, int id) {
+    if constexpr (std::is_same_v<State, nvshmemi_ibgda_device_state_v1>) {
+        int num_rc = state->num_rc_per_pe * state->num_devices_initialized;
+        return &state->globalmem.rcs[pe * num_rc + id % num_rc];
+    } else {
+        return &state->globalmem.rcs[pe + nvshmemi_device_state_d.npes * id];
+    }
+}
