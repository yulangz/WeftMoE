  "findings": [
    {
      "evidence": "Qwen35B M64 has zero static spill stores/loads in default and candidate binaries; Qwen35B M16 has 12-byte stores, 52/56-byte loads.",
      "implication": "Do not attribute the large-token M64 slowdown to register spilling."
    },
    {
      "evidence": "FP8 M64 mma_fp8 uses four N64 segments per K128 and wait<0> before scale accumulation for each. BF16 compute uses wait<1> and retains previous groups in flight.",
      "implication": "Increasing TMA stages alone does not remove the serialized MMA/scale work; overlapping segment MMA and scale accumulation is a future experiment, not a demonstrated optimization.",
      "source": "src/cuda/weftmoe_dt/fp8_compute.cuh"
    },
    {
      "evidence": "At512tokens, Qwen35B/122B prequantized source is only1.35/1.19us faster than online in the candidate run.",
      "implication": "Source quantization removal cannot explain or close the remaining BF16 latency gap."
    },
    {
      "evidence": "The forced-M64 candidate improves512-token latency but loses small-token cases.",
      "implication": "Retune also includes automatic-M stage2/3 slice configurations, keeping224/56registers fixed."
    }
  ],
